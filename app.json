{
  "expo": {
    "name": "Inventario QR",
    "slug": "inventario-qr",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "android": {
      "package": "com.inventarioqr.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "minSdkVersion": 21,
      "targetSdkVersion": 34,
      "compileSdkVersion": 34
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inventarioqr.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para tomar fotos de los items y escanear códigos QR.",
        "NSMicrophoneUsageDescription": "Esta app necesita acceso al micrófono para grabar videos."
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Esta app necesita acceso a la cámara para tomar fotos de los items y escanear códigos QR."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
